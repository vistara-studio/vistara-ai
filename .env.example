DB_HOST=localhost
DB_PORT=5432
DB_NAME=vistara_ai
DB_USER=vistara
DB_PASSWORD=vistara123
DB_MAX_CONNECTIONS=25
DB_SSL_MODE=disable

# AI Configuration
GEMINI_API_KEY=AIzaSyDY9XOPj2hQPdJhV8J6l_YHPfKXlA2wZYI
GEMINI_MODEL_NAME=gemini-2.5-flash

