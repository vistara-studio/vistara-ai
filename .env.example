# Vistara AI Service Environment Configuration

# Application Configuration
GO_ENV=development
PORT=5000
LOG_LEVEL=info

# Security Keys (for API authentication)
API_SECRET_KEY=vistara-secret-key

# JWT Configuration (must match vistara-be for token interoperability)
JWT_SECRET=vistara-jwt-key

# AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash

# Performance Configuration
REQUEST_TIMEOUT_SECONDS=60
MAX_TOKENS=4096
CONCURRENT_REQUESTS=3

# Service-specific timeouts (in seconds)
SMART_PLANNER_TIMEOUT_SECONDS=120
HISTORIAN_TIMEOUT_SECONDS=45
NUSALINGO_TIMEOUT_SECONDS=30

# CORS Configuration for integration
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Integration with Vistara BE
VISTARA_BE_URL=http://localhost:8080
